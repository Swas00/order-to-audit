msgid "%(msg)s (a further %(n)s packets are past expiry and cannot be sold)"
msgstr ""
"%(msg)s (மேலும் %(n)s பாக்கெட்டுகள் காலாவதியாகிவிட்டன, விற்க முடியாது)"

